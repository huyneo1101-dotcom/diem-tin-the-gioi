# Python cache (sinh ra khi import scripts/add_news.py)
__pycache__/
*.pyc

# File tạm khi quét tin
/tmp/new_items.json

# Cờ trạng thái của PHIÊN TEST hạ tầng (DIEMTIN_PHIEN_TEST=1). Sổ riêng, ephemeral —
# commit vào repo chỉ là rác, và tệ hơn: dễ bị đọc nhầm thành cờ thật khi chẩn đoán.
logs/state-test.json

# Cấu hình phiên Claude cục bộ — không commit
.claude/

# Kho tách ra ở BƯỚC DỰNG của pages.yml (scripts/cat_nhe_trang.py --tai-cho). Chỉ tồn tại
# trong runner CI; lỡ chạy cờ đó trên máy thì file này KHÔNG được lọt vào commit — kèm theo
# nó là một index.html đã cụt mất kho, mà 21 script Python vẫn ghi vào đấy như thường.
/data/kho.json
